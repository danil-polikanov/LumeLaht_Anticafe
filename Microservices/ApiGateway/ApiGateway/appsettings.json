{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "room-route": {
        "ClusterId": "room-cluster",
        "Match": {
          "Path": "/api/room/{**catch-all}"
        }
      },
      "image-route": {
        "ClusterId": "room-cluster",
        "Match": {
          "Path": "/api/image/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "room-cluster": {
        "Destinations": {
          "room-service": {
            "Address": "http://room-service:8080"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://user-service:8080"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-service": {
            "Address": "http://booking-service:8080"
          }
        }
      }
    }
  }
}
