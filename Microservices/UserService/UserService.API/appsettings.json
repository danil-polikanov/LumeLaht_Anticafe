{
  "ConnectionStrings": {
    "DefaultConnection": "Server=user-db;Database=LumeLaht_UserDb;User Id=sa;Password=LumeLaht_Pass123!;TrustServerCertificate=True"
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "LumeLaht",
    "Audience": "LumeLaht-Client",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
